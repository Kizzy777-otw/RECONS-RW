# Required to access /admin and issue signed admin session cookies.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required to authenticate inbound SMS webhook requests.
SMS_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Set to the RECONS team inbox. The public inquiry form opens the visitor's mail app.
NEXT_PUBLIC_CONTACT_EMAIL=info@recons.rw
